---
// agentfarm.space, the landing page. The order lives in data/page.js (plan v0.7 §5): the relay hero, the fleet wall,
// the whole farm on one board, then one chapter per district of the board, each opened by its tiles, and the close.
// docs/DESIGN.md has the map.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SideIndex from '../components/SideIndex.astro';
import Footer from '../components/Footer.astro';
import Chapter from '../components/Chapter.astro';
import Relay from '../components/sections/Relay.astro';
import Fleet from '../components/sections/Fleet.astro';
import Atlas from '../components/sections/Atlas.astro';
import Days from '../components/sections/Days.astro';
import Rules from '../components/sections/Rules.astro';
import Backlog from '../components/sections/Backlog.astro';
import Studio from '../components/sections/Studio.astro';
import Auto from '../components/sections/Auto.astro';
import Console from '../components/sections/Console.astro';
import Together from '../components/sections/Together.astro';
import Memory from '../components/sections/Memory.astro';
import Brains from '../components/sections/Brains.astro';
import Bridge from '../components/sections/Bridge.astro';
import NeverWaits from '../components/sections/NeverWaits.astro';
import Meter from '../components/sections/Meter.astro';
import Local from '../components/sections/Local.astro';
import Close from '../components/sections/Close.astro';
import Band from '../components/Band.astro';
import { page } from '../data/page.js';

const SECTION = {
  's-relay': Relay, 's-fleet': Fleet, 's-atlas': Atlas, 's-days': Days, 's-rules': Rules, 's-backlog': Backlog,
  's-studio': Studio, 's-auto': Auto, 's-console': Console, 's-together': Together, 's-memory': Memory, 's-brains': Brains, 's-bridge': Bridge,
  's-waits': NeverWaits,
  's-meter': Meter, 's-local': Local, 's-close': Close,
};
/* a chapter opener goes in front of the first section of each chapter */
const blocks = page.map((p, i) => ({ C: SECTION[p.id], opens: p.d !== undefined && page[i - 1]?.d !== p.d ? p.d : undefined, band: p.band, after: p.after }));
---
<Base
  title="Agent Farm · Mission control for AI agents in VS Code"
  description="Run Claude Code, Codex, Gemini, Antigravity and OpenCode from one console. Agents work through your project backlog item by item, code or not; relay chains run day and night across accounts, and nothing about your work is sent to us."
>
  <Header />
  <SideIndex />
  <main>
    {blocks.map(({ C, opens, band, after }) => <>{band && <Band p={band} />}{opens !== undefined && <Chapter d={opens} />}<C />{after && <Band p={after} />}</>)}
  </main>
  <Footer />
</Base>
