---
// /about/: who makes Agent Farm and how. The maker trades as an individual under the MuVuSOFT name (site.legal, owner
// 2026-10-12); every figure comes from data/facts.js and data/features.js, and the promises are the ones the Local
// chapter and the privacy page make (facts.licence). A photo of the maker's own workplace goes in data/photos.js as
// 'about' (the owner's own, not stock); until it is there the page has no photo strip.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Band from '../../components/Band.astro';
import '../../styles/pages/about.css';
import { site } from '../../data/site.js';
import { facts, licence } from '../../data/facts.js';
import { features } from '../../data/features.js';
import { photos } from '../../data/photos.js';
const L = site.legal;
const NUM = [
  [facts.releases, 'releases so far'],
  [String(features.length), 'things it does, in ten districts'],
  [facts.tests, 'tests that pass before a release'],
  [String(facts.runtimeDependencies), 'runtime dependencies'],
];
---
<Base title="About · Agent Farm" description={`Agent Farm is made by ${site.maker.name}, the name ${L.name} works under in ${L.country}: one maker, a farm of agents, and nothing about your work sent to us.`} script="legal">
  <Header />
  <main class="aboutp">
    <div class="wrap">
      <nav class="crumb" aria-label="You are here"><a href="../">Agent Farm</a><span>About</span></nav>
      <header class="ah">
        <div>
        <p class="pre">About</p>
        <h1>One maker.<br /><em>A farm of agents.</em></h1>
        <p class="lead">Agent Farm is made by {site.maker.name}, the name {L.name} works under, in {L.country}. There is no company and no sales team behind it: one person who wanted agents to keep working through a full context, an empty plan and the night, and built the tool that lets them.</p>
        </div>
        <a class="logo" href={site.maker.href}><img src="../assets/brand/muvusoft-logo.png" alt={site.maker.name} width="220" height="207" /></a>
      </header>
    </div>
    {photos.about && <Band p="about" plain />}
    <div class="wrap">
      <ul class="nums" aria-label="Agent Farm in numbers">
        {NUM.map(([n, t]) => <li><b>{n}</b><span>{t}</span></li>)}
      </ul>
      <div class="cols">
        <section>
          <h2>Why it exists</h2>
          <p>Every AI company sells its own tool, and each one wants your work inside it. Each stops when a context fills up or a plan runs out, and each forgets what the last session learned.</p>
          <p>Agent Farm sits in VS Code, beside the agent CLIs you already pay for, and makes them work as one farm: the work is handed on instead of stopped, every session is kept, and you can see what each step cost. It runs no model of its own.</p>
        </section>
        <section>
          <h2>How it is made</h2>
          <p>Agent Farm is built with Agent Farm. Agents in the farm work through its own backlog, hand the work on when a context fills, read its code and keep its technical notes up to date, and judges check what they bring back. A person decides what ships.</p>
        </section>
        <section>
          <h2>What we promise</h2>
          <ul>
            <li>Nothing about your work comes to us: no code, no prompts, no transcripts, no names of files or projects. There is no telemetry.</li>
            <li>The free version never contacts us. A paid licence checks its key {licence.checkEvery}, and keeps working for {licence.offlineDays} days without a connection.</li>
            <li>Your money back within 14 days of your first payment, for any reason.</li>
          </ul>
          <p class="more"><a href="../privacy/">Privacy</a><a href="../refunds/">Refunds</a><a href="../features/safe-and-yours-alone/">Safe and yours alone</a></p>
        </section>
        <section>
          <h2>Write to us</h2>
          <p>A question, a bug, an idea for the farm: write to <a href={`mailto:${L.email}`}>{L.email}</a>. It reaches the person who builds Agent Farm, not a ticket queue.</p>
          <dl class="who">
            <dt>Made by</dt><dd><a href={site.maker.href}>{site.maker.name}</a>, the trading name of {L.name}, an individual, not a company</dd>
            <dt>Based in</dt><dd>{L.country}</dd>
            <dt>Get it</dt><dd><a href={site.get.href}>Agent Farm on the VS Code Marketplace</a></dd>
          </dl>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>
