---
// Footer (plan §5.14): the maker stays quiet here, and the page says plainly that its screens use demo data.
import { site, rootOf } from '../data/site.js';
const root = rootOf(Astro.url);
---
<div class="wrap">
  <footer>
    <span class="ver">AF-WEB v{site.version} · screens rebuilt from the real app, with demo data</span>
    <nav aria-label="Footer">
      <a href={`${root}features/`}>Features</a>
      <a href={`${root}pricing/`}>Pricing</a>
      <a href={site.get.href}>VS Code Marketplace</a>
      <a href={`${root}terms/`}>Terms</a>
      <a href={`${root}privacy/`}>Privacy</a>
      <a href={`${root}refunds/`}>Refunds</a>
      {site.legal.email && <a href={`mailto:${site.legal.email}`}>Contact</a>}
      <span>Photos: Unsplash, Pexels</span>
      <span>Crafted by <a href={site.maker.href}>{site.maker.name}</a></span>
    </nav>
  </footer>
</div>
