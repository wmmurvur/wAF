---
// Together (plan §5.6): a mission. A lead plans round by round, delegates to a team on different engines,
// reads what comes back and ends with an honest verdict. The table and the Sentry block rebuild the Missions page
// (screenshot 043) with demo rows; the subtitle and the Sentry text are the app's own words.
import '../../styles/sections/together.css';
import { no } from '../../data/page.js';
const TEAM = [
  { id: 'dev', role: 'developer', eng: 'Claude', cls: '', y: 64 },
  { id: 'rev', role: 'reviewer', eng: 'Codex', cls: 'x', y: 168 },
  { id: 'tst', role: 'tester', eng: 'Antigravity', cls: 'a', y: 272 },
  { id: 'wri', role: 'writer', eng: 'OpenCode', cls: 'o', y: 376 },
];
const ROWS = [
  { m: 'Timeline export, end to end', adpt: true, lead: 'manager +3', st: [['running', 'run']], r: 'R3/8', t: '7', tok: '412.6k', c: '$0.62 (mixed)', at: 'Oct 11, 09:12', live: true },
  { m: 'Pricing table refresh', adpt: false, lead: 'manager +2', st: [['done', 'ok']], r: 'R4/6', t: '6', tok: '301.2k', c: '$0.48 (mixed)', at: 'Oct 10, 16:40' },
  { m: 'Do two agents really argue?', adpt: true, lead: 'reviewer +1', st: [['done', 'ok'], ['partial', 'part']], r: 'R2/5', t: '1', tok: '72.3k', c: '$0.10', at: 'Oct 9, 17:53' },
  { m: 'A chaired council that really argues', adpt: true, lead: 'manager +0', st: [['cancelled', 'can']], r: 'R1/8', t: '3', tok: '58.9k', c: '$0.11 (mixed)', at: 'Oct 9, 21:17' },
];
---
<section id="s-together" class="gap" aria-label="Missions: a lead, a team and an honest verdict">
  <div class="wrap">
    <p class="sx"><b>{no('s-together')}</b> Together</p>
    <div class="sh">
      <div><p class="pre">Missions · four engines, one team</p><h2>A lead, a team, <em>an honest verdict.</em></h2></div>
      <p class="lead">Give a mission to a lead. It plans round by round, hands tasks to agents on different engines, reads what comes back, and ends by saying how it really went. Partial is an answer too.</p>
    </div>
    <div class="tgrid">
      <div class="mgraph">
        <div class="mhead"><span id="t-round">ROUND 1 / 8</span><span id="t-phase">planning</span></div>
        <svg viewBox="0 0 520 440" role="img" aria-label="A lead agent sends tasks to four team agents and reads their results">
          {TEAM.map(n => <path class="wire" id={`t-w-${n.id}`} d={`M190,220 C262,220 258,${n.y} 330,${n.y}`} />)}
          <g class="node lead" id="t-lead">
            <rect x="20" y="180" width="170" height="80" />
            <text x="36" y="208" class="r">manager</text><text x="36" y="228" class="e">lead · Claude</text><text x="36" y="248" class="s" id="t-ls">planning round 1</text>
          </g>
          {TEAM.map(n => (
            <g class={`node ${n.cls}`} id={`t-n-${n.id}`}>
              <rect x="330" y={n.y - 32} width="170" height="64" />
              <text x="346" y={n.y - 8} class="r">{n.role}</text><text x="484" y={n.y - 8} class={`e ${n.cls}`} text-anchor="end">{n.eng}</text><text x="346" y={n.y + 16} class="s">idle</text>
            </g>
          ))}
          <g id="t-dots"></g>
        </svg>
        <div class="verdict" id="t-verdict" aria-live="polite"><b>Verdict</b><span class="pill ok">done</span><span class="pill part">partial</span><p>CSV and JSON lines export and pass their tests. The Windows path was never run, so the mission says partial, not done.</p></div>
      </div>

      <div class="mpanel" aria-label="The Missions page, rebuilt with demo data">
        <div class="mtabs"><span>Console</span><span class="on">Agent Farm — Missions</span><span>Live Timeline</span></div>
        <div class="mbody">
          <h3>Missions</h3>
          <p class="msub">Dynamic orchestration: a lead agent plans round by round, delegates to the team, and finishes with an honest verdict.</p>
          <div class="sentry" id="t-sentry" data-shows="sentry">
            <div class="sh1"><b>▾ Sentry</b><span class="run">RUNNING</span><span class="sq" id="t-sq">Backlog.md · item 4 of 11 · one clean session per item</span></div>
            <p>A campaign takes the next item off a project backlog, opens a clean unattended session on it as an ordinary task row, and when that row ends it reads what the session left behind and opens the next one — until you stop it.</p>
          </div>
          <div class="mscroll">
            <table class="mtable">
              <thead><tr><th>Mission</th><th>Lead + team</th><th>Status</th><th>Rounds</th><th>Tasks</th><th>Tokens</th><th>Cost</th><th class="at">Started</th></tr></thead>
              <tbody>
                {ROWS.map(r => (
                  <tr class={r.live ? 'live' : ''} id={r.live ? 't-row' : undefined}>
                    <td><span class="tw">›</span>{r.m}{r.adpt && <span class="adpt">ADPT</span>}</td>
                    <td>{r.lead}</td>
                    <td class="st">{r.st.map(([t, c]) => <span class={`pill ${c}`}>{t}</span>)}</td>
                    <td class="rd">{r.r}</td><td class="tk">{r.t}</td><td class="to">{r.tok}</td><td class="co">{r.c}</td><td class="at">{r.at}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
